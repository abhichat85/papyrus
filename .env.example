# Papyrus configuration. Every value here is optional — the defaults in
# src/papyrus/config.py are sensible for a laptop and safe for a server.

# ── Resource ceilings ────────────────────────────────────────────────
PAPYRUS_MAX_FILE_BYTES=52428800
PAPYRUS_MAX_PDF_PAGES=2000
PAPYRUS_MAX_SLIDES=1000
PAPYRUS_MAX_SHEET_ROWS=20000
PAPYRUS_MAX_SHEET_COLS=256
PAPYRUS_MAX_TABLE_CELLS=1000000
PAPYRUS_MAX_CSV_ROWS=50000
PAPYRUS_MAX_ARCHIVE_MEMBERS=500
PAPYRUS_MAX_ARCHIVE_RATIO=200
PAPYRUS_MAX_ARCHIVE_BYTES=419430400
PAPYRUS_MAX_ASSETS=500

# ── Web app ──────────────────────────────────────────────────────────
# Where the Next.js demo finds the engine.
PAPYRUS_API_URL=http://127.0.0.1:8787
